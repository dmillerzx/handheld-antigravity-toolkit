# Retroid Pocket 5 Provisioning Workspace .gitignore

# APK packages
*.apk
apks/*.apk
apks/**/*.apk
!apks/.gitkeep

# BIOS files (exclude binary dumps, retain directory structure)
bios/*
!bios/.gitkeep

# ROM dumps (exclude binary dumps across all platform subdirectories)
roms/**/*
!roms/**/
!roms/**/.gitkeep

# Local platform tools archive & extracted binaries
platform-tools/
*.zip

# GPU Driver archives
drivers/*
!drivers/.gitkeep

# Patches staging (exclude bulky fetched pnach patch dumps)
patches/ps2/*.pnach
!patches/ps2/.gitkeep


# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Operating system and editor artifacts
.DS_Store
Thumbs.db
*.log
task-*.log
scratch/
backups/
snapshots/
notes/
docs/review/
configs/system_backup/
.idea/
.vscode/
.leak-patterns

# Extracted native port binary assets (OTR, O2R, RSDK)
/assets/
staging/
*.rsdk
_n64_temp/
